#ifndef RECI_ESP32_CAM_SECRETS_H
#define RECI_ESP32_CAM_SECRETS_H

#define WIFI_SSID "TU_WIFI"
#define WIFI_PASSWORD "TU_CONTRASENA"

// IP de tu Mac en la misma red Wi-Fi, por ejemplo 192.168.1.40.
// No uses 127.0.0.1: desde la ESP32 esa dirección apunta a la propia ESP32.
#define RECI_API_BASE_URL "http://192.168.1.40:3000"

// Es el mismo ROBOT_API_KEY configurado en web/.env.local.
#define RECI_ROBOT_API_KEY "PEGA_AQUI_TU_ROBOT_API_KEY"

#endif  // RECI_ESP32_CAM_SECRETS_H
