# Copia este archivo como .env y completa tus datos. Nunca subas .env a GitHub.

# Producción. Para desarrollo local: http://IP_DE_TU_MAC:3000
RECI_API_BASE_URL=https://reci-rho.vercel.app

# El mismo ROBOT_API_KEY configurado en Vercel / web/.env.local.
RECI_ROBOT_API_KEY=PEGA_AQUI_TU_ROBOT_API_KEY

# Opcional. Si lo dejas vacío se detecta solo (/dev/cu.usbmodem...).
RECI_PUERTO_MEGA=

# 0 = cámara integrada de la Mac, 1 = webcam USB (prueba si sale la equivocada).
RECI_CAMARA=0
