# RECI web (Next.js) — Variables de entorno (copiar a .env.local — NO commitear)
#   cp .env.example .env.local

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
# Service role: solo se usa en el servidor (API routes), nunca se expone al cliente
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ── API del robot (ESP32-CAM / Arduino → web) ──
# Misma llave que configura el firmware en RECI_ROBOT_API_KEY
ROBOT_API_KEY=tu_llave_compartida_con_el_robot

# ── Servicio de visión (services/vision) ──
VISION_SERVICE_URL=http://127.0.0.1:8001
VISION_SERVICE_API_KEY=tu_llave_compartida_con_vision_service

# ── Servicio facial (services/face) ──
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_SERVICE_API_KEY=tu_llave_compartida_con_face_service
